# ==========================================
# FRONTEND (Node.js / React / Vite)
# ==========================================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production Builds
frontend/dist/
frontend/build/

# ==========================================
# BACKEND (Python)
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
.venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# SECRETS & ENVIRONMENT VARIABLES (CRITICAL)
# ==========================================
# Never commit your API keys, AWS tokens, or database passwords!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# ==========================================
# OS & IDE SPECIFIC JUNK
# ==========================================
# VS Code
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/

# Mac / Windows system files
.DS_Store
Thumbs.db